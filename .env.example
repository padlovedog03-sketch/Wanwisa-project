# Firebase Configuration for Teaching Internship Portfolio (Client-side / RTDB)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Serverless Database Sync on Vercel (Postgres / Neon)
# Auto-populated if Neon integration or Vercel Postgres is attached
POSTGRES_URL=postgres://default:secret@ep-cool-host.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require
DATABASE_URL=postgres://default:secret@ep-cool-host.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require


