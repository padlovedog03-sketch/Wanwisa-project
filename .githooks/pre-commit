#!/usr/bin/env bash
# Interception fallback for any assistant — or human — that cannot be stopped
# BEFORE it acts (RUNTIME-CONTRACT C1, "ทางถอยเมื่อไม่มี"). Runs the layer-1
# checks at commit time instead. Weaker than interception, and declared so in
# doc/framework/ADAPTERS.md: it catches a forged approval or a scar closed
# with no trace before it is recorded, but it cannot stop a destructive
# command, and `git commit --no-verify` skips it. The protected-branch CI
# (ci-examples/) is the layer nobody can skip.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

fail=0
for check in scripts/verify_approvals.py scripts/scar_status.py scripts/memory_lint.py scripts/check_neutrality.py; do
  if ! out=$(python3 "$check" 2>&1); then
    echo "pre-commit: FAIL $check"
    echo "$out" | sed 's/^/    /'
    fail=1
  fi
done

# The newest gate record for the tree being committed must not be RED
# (SPEC-verify-tiers-merge-gate-am3-commit-on-red). `git write-tree` with git's
# own GIT_INDEX_FILE is exactly that tree under commit, commit -a and commit -- path.
if [ ! -f scripts/verify_record.py ]; then
  echo "pre-commit: WARN verify record not checked — recorder missing (scripts/verify_record.py)"
elif ! staged=$(git write-tree 2>/dev/null); then
  echo "pre-commit: FAIL verify record — staged tree could not be hashed"
  fail=1
else
  out=$(python3 -I scripts/verify_record.py commit-check --tree "$staged" 2>&1); rc=$?
  case $rc in
    0) [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/pre-commit: /' ;;
    1) printf '%s\n' "$out" | sed 's/^/pre-commit: /'; fail=1 ;;
    *) echo "pre-commit: FAIL verify record — the check could not run (exit $rc)"; fail=1 ;;
  esac
fi

# CI gate 3 (ci-examples/github-actions.yml "ไม่มีตัวยึดหลงเหลือ") over the index being
# committed. Keep the pattern, roots and grep -v list equal to it, and `allowed`
# equal to bootstrap's substitution keys: tests/ci/test_ci_examples.py checks.
# In a template not yet bootstrapped (the staged AGENTS.md still holds the
# PROJECT placeholder) a line whose only tokens are bootstrap's five passes.
allowed='PROJECT|PACKAGE|BACKEND_REPO_PATH|FRONTEND_REPO_PATH|FRONTEND_REPO'
hits=$(LC_ALL=C git grep --cached -I -n --no-color -G '<[A-Z_]\{3,\}>' -- .claude .agents doc scripts AGENTS.md README.md); grc=$?
if [ "$grc" -gt 1 ]; then
  echo "pre-commit: FAIL placeholder scan — the scan could not run (git grep exit $grc)"
  fail=1
else
  hits=$(printf '%s\n' "$hits" | grep -v 'doc/framework/' | grep -v 'doc/templates/' \
         | grep -v 'scripts/bootstrap.sh' | grep -v '^\.claude/worktrees/' || true)
  if [ -n "$hits" ] && git grep --cached -q -F '<PROJECT>' -- AGENTS.md 2>/dev/null; then
    hits=$(printf '%s\n' "$hits" | LC_ALL=C awk -v allowed="$allowed" '
      BEGIN { n = split(allowed, a, "|"); for (i = 1; i <= n; i++) ok["<" a[i] ">"] = 1 }
      { rest = $0
        while (match(rest, /<[A-Z_][A-Z_][A-Z_][A-Z_]*>/)) {
          if (!(substr(rest, RSTART, RLENGTH) in ok)) { print; next }
          rest = substr(rest, RSTART + RLENGTH)
        } }')
  fi
  if [ -n "$hits" ]; then
    n=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
    echo "pre-commit: FAIL placeholder scan — $n line(s) CI gate 3 would fail on:"
    printf '%s\n' "$hits" | head -n 20 | sed 's/^/    /'
    if [ "$n" -gt 20 ]; then echo "    … and $((n - 20)) more"; fi
    fail=1
  fi
fi

if [[ $fail -ne 0 ]]; then
  echo "pre-commit: blocked — fix the failures above. --no-verify skips this hook, not CI, which runs the same checks."
fi
exit $fail
